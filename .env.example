# Copy to .env and fill in. Never commit .env.

# --- AWS / Bedrock ---
# Credentials come from the standard AWS chain (~/.aws/credentials or env vars).
# Do not put access keys here.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0
# Avast (or any antivirus) intercepts HTTPS with its own root CA. boto3 uses certifi
# and fails with CERTIFICATE_VERIFY_FAILED; point it at the interceptor's root cert.
# Leave unset on machines without TLS interception.
AWS_CA_BUNDLE=C:\ProgramData\Avast Software\Avast\wscert.pem

# --- Database ---
# Unset means in-memory SQLite (tests and evals). Set for Neon Postgres (seed, demo).
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# --- Gmail (read-only, Phase 11) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fernet key: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Cost guardrails ---
EVAL_MAX_CALLS=200
